<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CinemaHub.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="using:CinemaHub.Services"
        xmlns:helpers="clr-namespace:CinemaHub.ViewModels"
        xmlns:System="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d" d:DesignWidth="600" Height="600"
        x:Class="CinemaHub.Views.BuyATicketWindow"
        x:DataType="vm:BuyATicketViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CinemaHub">

    <Design.DataContext>
        <vm:BuyATicketViewModel/>
    </Design.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Visible">
    <Grid RowDefinitions="20*, 80*">
        <Grid Grid.Row="0" Background="#0D1730">
            <TextBlock FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Run Text="Cinema" Foreground="White"/>
                <Run Text="Hub" Foreground="Orange"/>
            </TextBlock>
            <TextBlock FontSize="24" Text="Покупка билета" Foreground="Orange" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ComboBox PlaceholderText="Меню" HorizontalAlignment="Right" VerticalAlignment="Center" Width="200" Height="50" HorizontalContentAlignment="Center" Background="#252F36" Foreground="Orange" PlaceholderForeground="#FFBB3E" FontSize="18" SelectedItem="{Binding Option, Mode=TwoWay}">
                <ComboBox.Items>
                    <Button Content="Фильмы" HorizontalAlignment="Stretch" Command="{x:Static helpers:PublicViewModelMethods.OpenFilmsCommand}" CommandParameter="{Binding $parent[Window]}"/>
                    <Button Content="Мои билеты" HorizontalAlignment="Stretch" Command="{x:Static helpers:PublicViewModelMethods.OpenMyTicketsCommand}" CommandParameter="{Binding $parent[Window]}"/>
                    <Button Content="Настройки" HorizontalAlignment="Stretch" Command="{x:Static helpers:PublicViewModelMethods.OpenOptionsCommand}" CommandParameter="{Binding $parent[Window]}"/>
                    <Button Content="Выход" HorizontalAlignment="Stretch" Command="{x:Static helpers:PublicViewModelMethods.LogOutCommand}" CommandParameter="{Binding $parent[Window]}"/>
                </ComboBox.Items>
                <ComboBox.Styles>
                    <Style Selector="ComboBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                 </ComboBox.Styles>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                <TextBlock Margin="0,10">
                    <Run Text="Название фильма:"/>
                    <Run Text="{Binding Seans.FilmName}" Foreground="Orange"/>
                </TextBlock>
                <TextBlock Margin="0,10">
                    <Run Text="Возрастное ограничение:"/>
                    <Run Text="{Binding Seans.FilmAdultRate}" Foreground="Orange"/>
                </TextBlock>
                <TextBlock Margin="0,10">
                    <Run Text="Зал:"/>
                    <Run Text="{Binding SelectedZal.Name}" Foreground="Orange"/>
                </TextBlock>
                <TextBlock Text="Место в зале" Margin="0,10"/>
                    <ListBox Margin="0,10" 
                     ItemsSource="{Binding Mesta}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedMesto}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="80" Height="80" Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding MestoName}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MestoStatus}" HorizontalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                <TextBlock Text="Тип билета" Margin="0,10"/>
                <ComboBox PlaceholderText="Выберите тип билета" ItemsSource="{Binding TypesTicketsList}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedTicketType, Mode=TwoWay}"/>
                <TextBlock Margin="0,10">
                    <Run Text="Цена за билет:"/>
                    <Run Text="{Binding Cost}" Foreground="Orange"/>
                </TextBlock>
                <TextBlock Margin="0,10">
                    <Run Text="Ваши данные:"/>
                    <Run Text="{Binding UserFamily}" Foreground="Orange"/>
                    <Run Text="{Binding UserName}" Foreground="Orange"/>
                    <Run Text="{Binding UserFather}" Foreground="Orange"/>
                </TextBlock>
                <TextBlock Margin="0,10">
                    <Run Text="Итого к оплате:"/>
                    <Run Text="{Binding Cost}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <Button Content="Купить" Command="{Binding BuyTicketCommand}"/>
                    <Button Content="Отмена" Command="{Binding GoBackCommand}" CommandParameter="{Binding $parent[Window]}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
    
</Window>
